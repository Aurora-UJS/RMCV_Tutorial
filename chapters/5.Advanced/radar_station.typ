  table(
    columns: (auto, auto, auto),
    align: (left, left, left),
    stroke: (x, y) => (
      top: if y == 0 or y == 1 { 1pt } else { 0pt },
      bottom: if y == 3 { 1pt } else { 0pt },
    ),
    inset: 7pt,
    table.header([*策略*], [判据], [主要失效模式]),
    [边沿触发＋状态机], [只认从特定值到特定值的那一次跳变], [跳变丢包会漏掉本次事件],
    [变化触发＋冷却], [值变了就触发，之后冷却一段时间], [冷却期内的真实意图被抑制],
    [电平触发], [值满足条件就一直请求], [人忘了复位就会反复请求],
