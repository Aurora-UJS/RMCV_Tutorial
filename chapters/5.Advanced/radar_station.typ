  table(
    columns: (auto, auto, auto, auto, auto),
    align: (left, right, right, right, right),
    stroke: (x, y) => (
      top: if y == 0 or y == 1 { 1pt } else { 0pt },
      bottom: if y == 2 { 1pt } else { 0pt },
    ),
    inset: 7pt,
    table.header([*倾角*], [侧向 7.5 m 处高差], [$R = 10$ m], [$R = 15$ m], [$R = 20$ m]),
    [1°], [0.131 m], [0.52 m], [0.79 m], [1.05 m],
    [2°], [0.262 m], [1.05 m], [1.57 m], [2.10 m],
  ),
