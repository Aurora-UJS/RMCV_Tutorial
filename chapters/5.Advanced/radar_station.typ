  table(
    columns: (auto, auto, auto),
    align: (left, left, left),
    stroke: (x, y) => (
      top: if y == 0 or y == 1 { 1pt } else { 0pt },
      bottom: if y == 4 { 1pt } else { 0pt },
    ),
    inset: 7pt,
    table.header([*关联策略*], [常见运动模型], [边界]),
    [逐帧检测框比对], [无或极简], [实现简单；交错、漏检和遮挡时容易换 ID],
    [匈牙利算法], [常速卡尔曼], [对给定代价矩阵求最小总代价指派；结果依赖门控、代价和运动模型],
    [拍卖算法], [Singer 机动模型], [迭代求解指派并可并行化；精度与速度取决于实现参数],
