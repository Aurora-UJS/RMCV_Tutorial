  table(
    columns: (auto, auto, auto, auto, 1fr),
    align: (left, center, center, center, left),
    stroke: (x, y) => (
      top: if y == 1 or y == 0 { 1pt } else { 0pt },
      bottom: if y == 4 { 1pt } else { 0pt },
    ),
    inset: 7pt,
