  [预测方差], [$sigma_("pred")^2 = sigma_(k-1)^2 + sigma_w^2$], [$bold(P)_(k|k-1) = bold(F) bold(P)_(k-1) bold(F)^top + bold(Q)$],
  [修正方差], [$sigma_k^2 = (1 - K) sigma_("pred")^2$], [$bold(P)_k = (bold(I) - bold(K) bold(H)) bold(P)_(k|k-1)$],
