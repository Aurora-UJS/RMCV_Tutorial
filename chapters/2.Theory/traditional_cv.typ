table(
  columns: (auto, auto, auto, auto),
  align: (left, center, center, center),
  stroke: (x, y) => (
    top: if y == 1 or y == 0 { 1pt } else { 0pt },
    bottom: if y == 3 { 1pt } else { 0pt },
  ),
  inset: 8pt,
